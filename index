rder:0;background:none;font-size:19px;position:relative;color:#657a73}.bell:after{content:"";position:absolute;right:0;top:0;width:6px;height:6px;border-radius:50%;background:#dc735f;border:2px solid #fff}.content{padding:32px 38px;max-width:1500px;margin:auto}.welcome{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px}.welcome h1{font:30px Georgia,serif;margin:0 0 7px;color:#153c32}.welcome p{margin:0;color:var(--muted);font-size:13px}.date{color:var(--muted);font-size:12px;padding-top:8px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:21px}.card{background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow)}.stat{padding:19px 20px;min-height:128px;position:relative}.stathead{display:flex;justify-content:space-between;align-items:center;color:var(--muted);font-size:12px}.staticon{width:34px;height:34px;border-radius:11px;display:grid;place-items:center;background:var(--mint);color:var(--green);font-size:16px}.statval{font:27px Georgia,serif;margin:14px 0 5px;color:#183c32}.statfoot{font-size:11px;color:#668077}.up{color:#2f8a67;font-weight:600}.dashboard{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(280px,.9fr);gap:17px;margin-bottom:18px}.panel{padding:20px 21px}.panelhead{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:20px}.panelhead h2{font:18px Georgia,serif;margin:0 0 5px}.panelhead p{font-size:11px;color:var(--muted);margin:0}.select{border:1px solid var(--line);border-radius:8px;padding:7px 10px;background:#fff;color:#63776f;font-size:11px}.chart{height:194px;position:relative;padding:8px 7px 25px 43px}.ylabels{position:absolute;left:0;top:7px;bottom:28px;display:flex;flex-direction:column;justify-content:space-between;color:#91a19a;font-size:10px}.plot{height:100%;position:relative;border-bottom:1px solid #dfe8e3;background:repeating-linear-gradient(to bottom,transparent 0,transparent 47px,#edf2ef 48px,#edf2ef 49px)}.plot svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}.months{display:flex;justify-content:space-between;color:#879891;font-size:10px;padding-top:8px}.chart-legend{display:flex;gap:16px;margin-top:12px;color:#70827d;font-size:10px}.dot{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:5px;background:#166c5a}.dot.gold{background:#d7aa5b}.goal{background:linear-gradient(145deg,#0d5b4c,#073d34);color:#fff;position:relative;overflow:hidden;border:0}.goal:before{content:"";position:absolute;width:230px;height:230px;border:1px solid #ffffff18;border-radius:50%;right:-95px;top:-95px}.goal:after{content:"";position:absolute;width:175px;height:175px;border:1px solid #ffffff14;border-radius:50%;right:-65px;top:-65px}.goal .panelhead{position:relative;z-index:1}.goal .panelhead h2{color:#fff}.goal .panelhead p{color:#b7d2c8}.goal .select{background:#ffffff16;color:#fff;border-color:#ffffff2b}.goalamount{font:31px Georgia,serif;position:relative;z-index:1;margin:3px 0 5px}.goalcaption{font-size:11px;color:#bdd6cd;position:relative;z-index:1}.progress{height:8px;background:#ffffff28;border-radius:10px;margin:20px 0 9px;position:relative;z-index:1}.progress span{height:100%;display:block;width:68%;background:#dfb461;border-radius:10px}.progressrow{display:flex;justify-content:space-between;color:#c3d9d1;font-size:10px;position:relative;z-index:1}.goalfoot{border-top:1px solid #ffffff25;margin-top:17px;padding-top:14px;display:flex;justify-content:space-between;position:relative;z-index:1}.goalfoot small{display:block;color:#aac9bd;font-size:10px;margin-bottom:4px}.goalfoot b{font-size:13px}.transactions{padding:20px 21px}.tablewrap{overflow:auto}table{width:100%;border-collapse:collapse;text-align:left;white-space:nowrap}th{font-size:10px;text-transform:uppercase;letter-spacing:.6px;color:#81928b;font-weight:600;padding:11px 9px;border-bottom:1px solid var(--line)}td{padding:12px 9px;border-bottom:1px solid #eff3f0;font-size:12px}tbody tr:last-child td{border:0}.person{display:flex;align-items:center;gap:9px}.miniava{width:31px;height:31px;background:#e9f3ee;border-radius:10px;display:grid;place-items:center;color:#28715c;font-size:11px;font-weight:700}.person b{display:block;font-size:11px}.person small{display:block;color:#8a9a94;font-size:10px;margin-top:3px}.amount{font-weight:700;color:#245846}.status{display:inline-flex;align-items:center;gap:5px;border-radius:20px;padding:5px 8px;background:#eaf5ed;color:#37805b;font-size:10px}.status:before{content:"";width:5px;height:5px;border-radius:50%;background:#4b9a67}.status.pending{background:#fff5e4;color:#a87521}.status.pending:before{background:#d9a84e}.linkbtn{color:#146b58;border:0;background:none;font-size:11px;font-weight:600}.actions{display:flex;gap:9px}.primary{border:0;border-radius:9px;background:#0d5b4c;color:white;padding:10px 14px;font-size:12px;font-weight:600;box-shadow:0 4px 10px #0d5b4c20}.primary:hover{background:#08483d}.secondary{border:1px solid var(--line);border-radius:9px;background:#fff;color:#46645a;padding:9px 13px;font-size:12px}.toast{position:fixed;bottom:20px;right:20px;background:#153e33;color:white;border-radius:10px;padding:12px 16px;box-shadow:var(--shadow);opacity:0;transform:translateY(10px);transition:.25s;pointer-events:none;font-size:12px}.toast.show{opacity:1;transform:translateY(0)}
@media(max-width:1050px){.sidebar{width:215px}.content{padding:27px 24px}.topbar{padding:0 24px}.stats{grid-template-columns:repeat(2,1fr)}}@media(max-width:760px){.sidebar{width:66px;padding:18px 8px}.brand{padding:0 5px 25px}.brandmark{flex:none}.brandtext,.navlabel,.nav a span:not(.ico),.sidebottom>div:not(.avatar){display:none}.nav a{justify-content:center;padding:12px 5px}.nav .ico{font-size:18px}.sidebottom{justify-content:center;padding:16px 0}.topbar{height:65px;padding:0 15px}.branch{max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.content{padding:23px 15px}.welcome h1{font-size:26px}.dashboard{grid-template-columns:1fr}.date{display:none}.stats{gap:10px}.stat{padding:15px;min-height:117px}.statval{font-size:23px}.stathead{font-size:11px}.panel,.transactions{padding:17px 14px}}@media(max-width:420px){.stats{grid-template-columns:1fr 1fr}.statval{font-size:21px}.topright{gap:8px}.branch{font-size:10px;padding:8px}.welcome h1{font-size:24px}}

.mo{display:none;position:fixed;inset:0;background:#0a1f1acc;z-index:50;align-items:center;justify-content:center;padding:16px}.mo.on{display:flex}.box{background:#fff;border-radius:14px;padding:22px;width:100%;max-width:420px;max-height:90vh;overflow:auto}.box h3{font:20px Georgia,serif;margin:0 0 14px}
label{display:block;font-size:11px;color:var(--muted);margin-bottom:11px}input,select,textarea{display:block;width:100%;margin-top:5px;padding:10px;border:1px solid var(--line);border-radius:8px;font:inherit;color:var(--ink);background:#fff}input[type=color]{height:40px;padding:3px}
.bars{display:flex;align-items:flex-end;gap:12px;height:190px;padding-top:8px}.bc{flex:1;height:100%;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;font-size:10px;color:#879891;gap:6px}.bar{width:100%;max-width:56px;background:var(--green);border-radius:7px 7px 0 0;min-height:2px}.bc i{font-style:normal}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:0 14px}.bar2{height:6px;background:#e5ece8;border-radius:6px;min-width:70px}.bar2 span{display:block;height:100%;background:var(--gold);border-radius:6px}
.goal{background:linear-gradient(145deg,var(--green),var(--deep))}.sidebar{background:var(--deep)}.pad{padding:20px 21px;margin-bottom:17px}.tools{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:14px}.tools input{margin:0;max-width:280px}.danger{color:#c0392b}.empty{padding:26px;text-align:center;color:var(--muted)}.note{font-size:12px;color:var(--muted);line-height:1.6}
@media(max-width:760px){.g2{grid-template-columns:1fr}.dashboard{grid-template-columns:1fr}}
