<body>
<div class="app"><aside class="sidebar"><div class="brand"><div class="brandmark" id="logo"></div><div class="brandtext"><strong id="bn"></strong><small id="bt"></small></div></div><div class="navlabel">Menu utama</div><nav class="nav" id="n1"></nav><div class="navlabel">Kelola</div><nav class="nav" id="n2"></nav><div class="sidebottom"><div class="avatar" id="av"></div><div><b id="an"></b><small id="ar"></small></div></div></aside>
<main class="main"><header class="topbar"><div class="crumb">Halaman utama &nbsp;›&nbsp; <b id="cr"></b></div><div class="topright"><span class="branch" id="bb"></span></div></header><div class="content" id="view"></div></main></div>
<div id="lg" style="display:none;position:fixed;inset:0;background:var(--bg);z-index:60;align-items:center;justify-content:center;padding:16px"></div><div class="toast" id="toast"></div><div class="mo" id="mo"></div><input type="file" id="rf" accept=".json" hidden>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.min.js"></script>
<script src="config.js"></script>
<script>
const $=s=>document.querySelector(s),KEY='umroh_app_v1',METODE=['Transfer bank','Virtual account','Setor tunai','QRIS'];
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const rp=n=>'Rp '+Math.round(n).toLocaleString('id-ID');
const sh=n=>n>=1e9?'Rp '+(n/1e9).toFixed(2).replace('.',',')+' M':n>=1e6?'Rp '+(n/1e6).toFixed(1).replace('.',',')+' jt':rp(n);
const iso=d=>d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
const fd=d=>new Date(d+'T00:00').toLocaleDateString('id-ID',{day:'numeric',month:'short',year:'numeric'});
const ini=n=>String(n).trim().split(/\s+/).map(w=>w[0]).slice(0,2).join('').toUpperCase();
let tm;const msg=t=>{const e=$('#toast');e.textContent=t;e.classList.add('show');clearTimeout(tm);tm=setTimeout(()=>e.classList.remove('show'),2200)};
/* ===== Lapisan data: ganti isi Store ini dengan API/database saat sudah multi-user ===== */
const dm=(k,d)=>{const x=new Date();x.setDate(d);x.setMonth(x.getMonth()-k);return iso(x)};
const demo=()=>({s:{biro:'Nama Biro Anda',tag:'UMROH & HAJI',logo:'✦',admin:'Admin Biro',peran:'Admin biro',wa:'',alamat:'',rek:'',target:1270000000,tahun:2027,warna:'#0d5b4c'},
p:[{id:'p1',n:'Reguler 2027',harga:35000000,kuota:40,ber:'Mar 2027'},{id:'p2',n:'Plus Turki 2027',harga:42000000,kuota:30,ber:'Jun 2027'}],
j:[['Siti Aminah','p1'],['H. Fauzan','p2'],['Rina Nurjanah','p1'],['Maulana Akbar','p1']].map((x,i)=>({id:'UMR-2026-000'+(i+1),n:x[0],hp:'0812000000'+i,paket:x[1]})),
t:[...[5,4,3,2,1,0].flatMap((k,i)=>[{j:'UMR-2026-0001',v:2e6+i*5e5},{j:'UMR-2026-0002',v:5e6},{j:'UMR-2026-0004',v:3e6}].map((x,q)=>({id:'d'+k+q,j:x.j,tgl:dm(k,5+q*6),m:METODE[q],v:x.v,st:'ok'}))),{id:'d9',j:'UMR-2026-0003',tgl:iso(new Date()),m:'Transfer bank',v:1e6,st:'pending'}]});
const Store={load(){try{return JSON.parse(localStorage.getItem(KEY))}catch(e){return null}},save(){try{localStorage.setItem(KEY,JSON.stringify(D))}catch(e){msg('Gagal menyimpan data')}}};
let D={s:{biro:'',tag:'',logo:'',admin:'',peran:'',warna:'#0d5b4c',target:0,tahun:2027},p:[],j:[],t:[]},cur='home',q='';
/* ===== Helper hitung ===== */
const ok=()=>D.t.filter(x=>x.st=='ok'&&!x.void),tot=()=>ok().reduce((a,x)=>a+x.v,0),paid=id=>ok().filter(x=>x.j==id).reduce((a,x)=>a+x.v,0);
const J=id=>D.j.find(x=>x.id==id),P=id=>D.p.find(x=>x.id==id),nid=()=>'UMR-'+new Date().getFullYear()+'-'+String(1+Math.max(0,...D.j.map(x=>+x.id.split('-')[2]||0))).padStart(4,'0');
function months(){const r=[];for(let i=5;i>=0;i--){const d=new Date();d.setDate(1);d.setMonth(d.getMonth()-i);const k=iso(d).slice(0,7);r.push({l:d.toLocaleDateString('id-ID',{month:'short'}),v:ok().filter(x=>x.tgl.startsWith(k)).reduce((a,x)=>a+x.v,0)})}return r}
function dark(h,f){const n=parseInt(h.slice(1),16);return '#'+[n>>16,n>>8&255,n&255].map(c=>Math.round(c*f).toString(16).padStart(2,'0')).join('')}
function theme(){const s=D.s,r=document.documentElement.style;r.setProperty('--green',s.warna);r.setProperty('--deep',dark(s.warna,.62));document.title=s.biro+' — Dashboard';$('#logo').textContent=s.logo||ini(s.biro);$('#bn').textContent=s.biro;$('#bt').textContent=s.tag;$('#av').textContent=ini(s.admin);$('#an').textContent=s.admin;$('#ar').textContent=s.peran;$('#bb').textContent='▣  '+s.biro}
/* ===== Tampilan ===== */
const N1=[['home','▦','Ringkasan'],['jamaah','♙','Data Jamaah'],['setoran','▤','Tabungan'],['paket','✧','Paket Umroh']],N2=[['laporan','▥','Laporan'],['set','⚙','Pengaturan']];
const trow=(x,full)=>`<tr><td><div class="person"><span class="miniava">${esc(ini(J(x.j)?.n||'?'))}</span><span><b>${esc(J(x.j)?.n||'(diarsipkan)')}</b><small>${esc(x.j)}</small></span></div></td><td>${fd(x.tgl)}</td><td>${esc(x.m)}</td><td class="amount">${rp(x.v)}</td><td><span class="status ${x.st=='ok'&&!x.void?'':'pending'}">${x.void?'Dibatalkan':x.st=='ok'?'Terkonfirmasi':'Menunggu'}</span></td>${full?`<td>${x.void?'':(x.st!='ok'?`<button class="linkbtn" data-act="ok" data-id="${x.id}">Konfirmasi</button> `:'')+`<button class="linkbtn danger" data-act="delT" data-id="${x.id}">Batalkan</button>`}</td>`:''}</tr>`;
const tbl=(h,rows)=>rows?`<div class="tablewrap"><table><thead><tr>${h.map(x=>`<th>${x}</th>`).join('')}</tr></thead><tbody>${rows}</tbody></table></div>`:'<div class="empty">Belum ada data.</div>';
const head=(t,p,b='')=>`<section class="welcome"><div><h1>${t}</h1><p>${p}</p></div><div class="actions">${b}</div></section>`;
const V={
home(){const s=D.s,T=tot(),td=iso(new Date()),pend=D.t.filter(x=>x.st!='ok'&&!x.void).length,m=months(),mx=Math.max(1,...m.map(x=>x.v)),pc=Math.min(100,T/s.target*100||0),avg=m.slice(-3).reduce((a,x)=>a+x.v,0)/3,last=[...D.t].sort((a,b)=>b.tgl.localeCompare(a.tgl)).slice(0,5);
const st=(a,i,v,f)=>`<article class="card stat"><div class="stathead">${a}<span class="staticon">${i}</span></div><div class="statval">${v}</div><div class="statfoot">${f}</div></article>`;
return `<section class="welcome"><div><h1>Assalamu’alaikum, ${esc(s.admin.split(' ')[0])} 👋</h1><p>Ringkasan tabungan dan aktivitas ${esc(s.biro)}.</p></div><div class="date">${new Date().toLocaleDateString('id-ID',{weekday:'long',day:'numeric',month:'long',year:'numeric'})}</div></section>
<section class="stats">${st('Total jamaah','♙',D.j.length,'terdaftar')}${st('Dana terkumpul','◈',sh(T),'terkonfirmasi')}${st('Setoran hari ini','⇧',sh(ok().filter(x=>x.tgl==td).reduce((a,x)=>a+x.v,0)),'Dari <b>'+D.t.filter(x=>x.tgl==td).length+' transaksi</b>')}${st('Menunggu konfirmasi','◷',pend,'Perlu ditinjau')}</section>
<section class="dashboard"><article class="card panel"><div class="panelhead"><div><h2>Perkembangan tabungan</h2><p>Dana terkonfirmasi per bulan (6 bulan terakhir)</p></div></div><div class="bars">${m.map(x=>`<div class="bc" title="${rp(x.v)}"><i>${sh(x.v).replace('Rp ','')}</i><div class="bar" style="height:${x.v/mx*75}%"></div>${x.l}</div>`).join('')}</div></article>
<article class="card panel goal"><div class="panelhead"><div><h2>Target keberangkatan</h2><p>Tahun ${s.tahun}</p></div></div><div class="goalamount">${rp(T)}</div><div class="goalcaption">dari target ${rp(s.target)}</div><div class="progress"><span style="width:${pc}%"></span></div><div class="progressrow"><span>${pc.toFixed(0)}% tercapai</span><span>${D.j.length} jamaah</span></div><div class="goalfoot"><div><small>Kurang</small><b>${sh(Math.max(0,s.target-T))}</b></div><div><small>Rata-rata/bulan</small><b>${sh(avg)}</b></div></div></article></section>
<section class="card transactions"><div class="panelhead"><div><h2>Setoran terbaru</h2><p>Transaksi tabungan jamaah yang baru masuk</p></div><button class="secondary" data-go="setoran">Lihat semua →</button></div>${tbl(['Jamaah','Tanggal','Metode','Nominal','Status'],last.map(x=>trow(x)).join(''))}</section>`},
jamaah(){return head('Data Jamaah',D.j.length+' jamaah terdaftar','<button class="primary" data-act="addJ">＋ Tambah jamaah</button>')+`<div class="card pad"><div class="tools"><input id="q" placeholder="Cari nama / nomor…" value="${esc(q)}" oninput="q=this.value;$('#jt').innerHTML=jrows()"></div><div id="jt">${jrows()}</div></div>`},
setoran(){return head('Tabungan','Seluruh setoran jamaah','<button class="primary" data-act="addT">＋ Catat setoran</button>')+`<div class="card pad">${tbl(['Jamaah','Tanggal','Metode','Nominal','Status',''],[...D.t].sort((a,b)=>b.tgl.localeCompare(a.tgl)).map(x=>trow(x,1)).join(''))}</div>`},
paket(){return head('Paket Umroh','Atur paket dan harga yang ditawarkan','<button class="primary" data-act="addP">＋ Tambah paket</button>')+`<div class="card pad">${tbl(['Paket','Harga','Berangkat','Kuota','Terisi',''],D.p.map(p=>`<tr><td><b>${esc(p.n)}</b></td><td class="amount">${rp(p.harga)}</td><td>${esc(p.ber)}</td><td>${p.kuota}</td><td>${D.j.filter(j=>j.paket==p.id).length}</td><td><button class="linkbtn danger" data-act="delP" data-id="${p.id}">Hapus</button></td></tr>`).join(''))}</div>`},
laporan(){const rows=D.p.map(p=>{const js=D.j.filter(j=>j.paket==p.id),tg=js.reduce((a,j)=>a+(j.harga??p.harga),0),tr=js.reduce((a,j)=>a+paid(j.id),0);return `<tr><td><b>${esc(p.n)}</b></td><td>${js.length}</td><td class="amount">${rp(tg)}</td><td class="amount">${rp(tr)}</td><td class="amount">${rp(Math.max(0,tg-tr))}</td></tr>`}).join('');
return head('Laporan','Rekap per paket & ekspor data','<button class="secondary" data-act="csv" data-id="j">⬇ Jamaah (CSV)</button><button class="secondary" data-act="csv" data-id="t">⬇ Setoran (CSV)</button>')+`<div class="card pad">${tbl(['Paket','Jamaah','Total tagihan','Terkumpul','Sisa'],rows)}</div>`},
set(){const s=D.s,F=[['biro','Nama biro'],['tag','Tagline'],['logo','Logo (1–2 huruf/emoji)'],['admin','Nama admin'],['peran','Jabatan'],['wa','No. WhatsApp'],['alamat','Alamat'],['rek','Rekening pembayaran'],['target','Target dana (Rp)','number'],['tahun','Tahun keberangkatan','number'],['warna','Warna utama','color'],['kode','Kode nomor jamaah (3 huruf)']];
return head('Pengaturan','Sesuaikan dashboard dengan identitas biro Anda')+`<div class="card pad"><div class="g2">${F.map(f=>`<label>${f[1]}<input id="s_${f[0]}" type="${f[2]||'text'}" value="${esc(s[f[0]])}"></label>`).join('')}</div><div class="actions"><button class="primary" data-act="saveS">Simpan pengaturan</button></div></div>
<div class="card pad"><div class="panelhead"><div><h2>Data & akun</h2><p class="note">Data tersimpan aman di server dan terpisah per biro.</p></div></div><div class="actions"><button class="secondary" data-act="bak">⬇ Unduh cadangan</button><button class="secondary" data-act="out">Keluar</button></div></div>`}};
function jrows(){const k=q.toLowerCase(),l=D.j.filter(j=>(j.n+j.id).toLowerCase().includes(k));return tbl(['Jamaah','HP','Paket','Terkumpul','Sisa','Progres',''],l.map(j=>{const p=P(j.paket),pd=paid(j.id),hg=p?(j.harga??p.harga):0,pc=p?Math.min(100,pd/hg*100):0;return `<tr><td><div class="person"><span class="miniava">${esc(ini(j.n))}</span><span><b>${esc(j.n)}</b><small>${esc(j.id)}</small></span></div></td><td>${esc(j.hp)}</td><td>${esc(p?.n||'-')}</td><td class="amount">${rp(pd)}</td><td>${p?rp(Math.max(0,hg-pd)):'-'}</td><td><div class="bar2"><span style="width:${pc}%"></span></div></td><td><button class="linkbtn" data-act="addT" data-id="${j.id}">Setor</button> <button class="linkbtn danger" data-act="delJ" data-id="${j.id}">Hapus</button></td></tr>`}).join(''))}
function render(){const nv=(a)=>a.map(n=>`<a href="#" data-go="${n[0]}" class="${n[0]==cur?'active':''}"><span class="ico">${n[1]}</span><span>${n[2]}</span></a>`).join('');$('#n1').innerHTML=nv(N1);$('#n2').innerHTML=nv(N2);$('#cr').textContent=[...N1,...N2].find(n=>n[0]==cur)[2];$('#view').innerHTML=V[cur]();theme()}
const go=v=>{cur=v;render();scrollTo(0,0)};
/* ===== Form & aksi ===== */
function form(title,fs,cb){$('#mo').innerHTML=`<div class="box"><h3>${title}</h3><form id="f">${fs.map(f=>`<label>${f.l}${f.o?`<select name="${f.k}">${f.o.map(o=>`<option value="${esc(o[0])}" ${o[0]==f.v?'selected':''}>${esc(o[1])}</option>`).join('')}</select>`:`<input name="${f.k}" type="${f.t||'text'}" value="${esc(f.v??'')}" ${f.t=='number'?'min="0" step="any" required':''} ${f.r?'required':''}>`}</label>`).join('')}<div class="actions"><button type="button" class="secondary" data-act="close">Batal</button><button class="primary">Simpan</button></div></form></div>`;$('#mo').classList.add('on');$('#f').onsubmit=e=>{e.preventDefault();cb(Object.fromEntries(new FormData(e.target)));A.close()}}
const dl=(name,txt,type)=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+txt],{type}));a.download=name;a.click()};
const A={close:()=>$('#mo').classList.remove('on'),
addJ:()=>form('Tambah jamaah',[{k:'n',l:'Nama lengkap',r:1},{k:'hp',l:'No. HP'},{k:'paket',l:'Paket',o:[['','— belum dipilih —'],...D.p.map(p=>[p.id,p.n])]}],v=>{run(SB.from('jamaah').insert({n:v.n,hp:v.hp,paket:v.paket||null})).then(o=>o&&msg('Jamaah ditambahkan'))}),
addT:id=>D.j.length?form('Catat setoran',[{k:'j',l:'Jamaah',v:id,o:D.j.map(j=>[j.id,j.n+' · '+j.id])},{k:'tgl',l:'Tanggal',t:'date',v:iso(new Date()),r:1},{k:'m',l:'Metode',o:METODE.map(m=>[m,m])},{k:'v',l:'Nominal (Rp)',t:'number'},{k:'st',l:'Status',o:[['ok','Terkonfirmasi'],['pending','Menunggu']]}],v=>{run(SB.from('setoran').insert({j:v.j,tgl:v.tgl,m:v.m,v:+v.v,st:v.st})).then(o=>o&&msg('Setoran dicatat'))}):msg('Tambah jamaah dulu'),
addP:()=>form('Tambah paket',[{k:'n',l:'Nama paket',r:1},{k:'harga',l:'Harga (Rp)',t:'number'},{k:'ber',l:'Perkiraan berangkat'},{k:'kuota',l:'Kuota',t:'number'}],v=>{run(SB.from('paket').insert({n:v.n,harga:+v.harga,ber:v.ber,kuota:+v.kuota}))}),
ok:id=>run(SB.from('setoran').update({st:'ok'}).eq('id',id)),
delT:id=>confirm('Batalkan setoran ini? Catatan tetap tersimpan sebagai riwayat.')&&run(SB.from('setoran').update({void:true}).eq('id',id)),
delJ:id=>confirm('Arsipkan jamaah ini? Riwayat setoran tetap tersimpan.')&&run(SB.from('jamaah').update({aktif:false}).eq('id',id)),
delP:id=>confirm('Hapus paket ini?')&&run(SB.from('paket').delete().eq('id',id)),
saveS:()=>{['biro','tag','logo','admin','peran','wa','alamat','rek','target','tahun','warna','kode'].forEach(k=>{let v=$('#s_'+k).value;D.s[k]=['target','tahun'].includes(k)?+v||0:v});save();render();msg('Pengaturan disimpan')},
csv:k=>{const r=k=='j'?[['ID','Nama','HP','Paket','Terkumpul'],...D.j.map(j=>[j.id,j.n,j.hp,P(j.paket)?.n||'',paid(j.id)])]:[['Tanggal','ID Jamaah','Nama','Metode','Nominal','Status'],...D.t.map(x=>[x.tgl,x.j,J(x.j)?.n||'',x.m,x.v,x.st])];dl(k=='j'?'jamaah.csv':'setoran.csv',r.map(a=>a.map(c=>`"${String(c).replace(/"/g,'""')}"`).join(',')).join('\n'),'text/csv')},
bak:()=>dl('cadangan-'+iso(new Date())+'.json',JSON.stringify(D),'application/json'),rest:()=>$('#rf').click(),
empty:()=>confirm('Hapus semua jamaah, setoran, dan paket? Pengaturan biro tetap.')&&(D={s:D.s,p:[],j:[],t:[]},save(),render()),
rst:()=>confirm('Kembalikan semua data ke contoh?')&&(D=demo(),save(),render())};
document.addEventListener('click',e=>{const a=e.target.closest('[data-go],[data-act]');if(!a)return;e.preventDefault();a.dataset.go?go(a.dataset.go):A[a.dataset.act](a.dataset.id)});
$('#rf').onchange=e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{const d=JSON.parse(r.result);if(!d.s||!Array.isArray(d.j)||!Array.isArray(d.p)||!Array.isArray(d.t))throw 0;D=d;save();render();msg('Cadangan dipulihkan')}catch(x){msg('File cadangan tidak valid')}};r.readAsText(f);e.target.value=''};
const SB=supabase.createClient(SUPABASE_URL,SUPABASE_KEY);
async function all(t,o){let out=[];for(let i=0;;i+=1000){const{data,error}=await SB.from(t).select('*').order(o).order('id').range(i,i+999);if(error)return{error};out=out.concat(data);if(data.length<1000)return{data:out}}}
async function load(){const r=await Promise.all([SB.from('biro').select('*').single(),all('paket','created_at'),all('jamaah','id'),all('setoran','tgl')]);const e=r.find(x=>x.error);if(e){msg(e.error.code=='PGRST116'?'Akun belum dihubungkan ke biro, atau langganan biro tidak aktif':e.error.message);return false}D={s:r[0].data,p:r[1].data,j:r[2].data.filter(x=>x.aktif!==false).map(x=>({...x,paket:x.paket||''})),t:r[3].data};render();return true}
async function run(q){const r=await q;if(r.error){msg(r.error.code=='42501'?'Akses ditolak: hanya admin yang boleh melakukan ini':r.error.message);return false}return load()}
A.saveS=async()=>{const o={};['biro','tag','logo','admin','peran','wa','alamat','rek','target','tahun','warna','kode'].forEach(k=>{const v=$('#s_'+k).value;o[k]=['target','tahun'].includes(k)?+v||0:v});if(await run(SB.from('biro').update(o).eq('id',D.s.id)))msg('Pengaturan disimpan')};
A.out=async()=>{await SB.auth.signOut();location.reload()};
function showLogin(){const l=$('#lg');l.style.display='flex';l.innerHTML=`<form class="box" id="lf"><h3>Masuk dashboard</h3><label>Email<input name="e" type="email" required></label><label>Kata sandi<input name="p" type="password" required></label><button class="primary" style="width:100%">Masuk</button></form>`;$('#lf').onsubmit=async ev=>{ev.preventDefault();const f=new FormData(ev.target),r=await SB.auth.signInWithPassword({email:f.get('e'),password:f.get('p')});if(r.error)return msg('Email atau kata sandi salah');boot()}}
async function boot(){const{data}=await SB.auth.getSession();if(!data.session)return showLogin();if(await load())$('#lg').style.display='none';else showLogin()}
boot();
</script>
